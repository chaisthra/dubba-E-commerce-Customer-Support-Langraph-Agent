# Anthropic (primary LLM provider)
ANTHROPIC_API_KEY=

# Groq (fallback provider when Anthropic is entirely down; also the sole provider
# used for rolling short-term-memory summarization, see harness/summarizer.py)
GROQ_API_KEY=

# Langfuse (tracing). Self-hosted via Docker by default now (langfuse/langfuse's own
# docker-compose.yml, cloned as a sibling directory -- not part of this repo -- see
# log/DECISIONS.md). Get public/secret keys from LANGFUSE_INIT_PROJECT_PUBLIC_KEY /
# LANGFUSE_INIT_PROJECT_SECRET_KEY in that clone's .env, or from the web UI at
# LANGFUSE_BASE_URL after logging in. Point back at LANGFUSE_BASE_URL=https://cloud.langfuse.com
# with cloud keys instead if you'd rather not run the self-hosted stack locally.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000

# Postgres (short-term checkpointer state + long-term ticket history). Same var
# name works for local Docker now and AWS RDS later -- only the value changes.
# Port 5433, not 5432 -- see docker-compose.yml if 5432 is already taken locally.
DATABASE_URL=postgresql://dubba:dubba@localhost:5433/dubba
